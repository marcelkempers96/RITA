---
// Photo slot. Resolves its `shot` (or the programme `code`, for generic slots) through src/lib/photos.ts and
// renders a responsive <picture> (AVIF/WebP, srcset) with the credit overlaid bottom-left. If no photo is
// available yet it renders a ▣ placeholder captioned with the shot needed (ASSETS-CHECKLIST §4).
// Pass `src` + `alt` (+ `credit`) to override with a specific image; alt text is required for real images.
import { Picture } from 'astro:assets';
import { resolvePhoto } from '../lib/photos';
interface Props { shot?: string; src?: string; alt?: string; credit?: string; ratio?: string; class?: string; top?: boolean; eager?: boolean; kind?: string; code?: string; seed?: string; sizes?: string }
const { shot = 'Photo', src, alt = '', credit, ratio = '4 / 3', class: cls, top = false, eager = false, kind = 'Photo', code, seed, sizes = '(min-width: 900px) 50vw, 100vw' } = Astro.props;
// Portraits never fall back to stock photography.
const locals = Astro.locals as { usedPhotos?: Set<string> };
locals.usedPhotos ??= new Set();
const photo = !src && kind !== 'Portrait' ? resolvePhoto(shot, code, seed ?? Astro.url.pathname, locals.usedPhotos) : undefined;
---
<div class:list={['ph', cls, { 'ph-top': top, 'ph-real': src || photo }]} style={`--ar:${ratio}`}>
  {photo ? (
    <>
      <Picture src={photo.image} alt={photo.alt} formats={['avif', 'webp']} widths={[480, 800, 1280, 1600]} sizes={sizes} quality={60}
        loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
      {photo.credit && <span class="ph-cap credit">{photo.credit}</span>}
    </>
  ) : src ? (
    <>
      <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
      {credit && <span class="ph-cap credit">{credit}</span>}
    </>
  ) : (
    <span class="ph-cap" aria-hidden="true">▣ {kind} · {shot}</span>
  )}
</div>
<style>
  .ph-real { background-image: none; }
  .ph-real :global(picture) { display: contents; }
  .ph-real :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .credit { font: 400 12px/1.3 var(--mono); text-transform: none; letter-spacing: 0; top: auto !important; bottom: 12px; left: 12px; padding: 3px 7px; background: rgba(17, 17, 16, .72); color: var(--white); }
</style>
