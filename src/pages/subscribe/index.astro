---
import Base from '../../layouts/Base.astro';
// Double opt-in: form → check your inbox (resend after 60s) → confirmed (/subscribe/confirm, the provider's redirect).
const endpoint = import.meta.env.PUBLIC_FORMS_ENDPOINT;
const action = endpoint ? `${endpoint}/newsletter` : 'mailto:info@rita.africa?subject=Subscribe%20to%20RITA%20newsletters';
---
<Base title="Subscribe" description="Policy Insights every week, RITA news monthly." noNewsletter>
  <span hidden data-pagefind-filter="type">Page</span>
  <section class="section bg-paper">
    <div class="wrap">
      <div class="panel" data-state="form">
        <div class="center">
          <h1 class="h1">Stay informed</h1>
          <p class="lead mt-16">Policy Insights every week, RITA news monthly.</p>
        </div>
        <form class="form mt-32" action={action} method="post" enctype={endpoint ? undefined : 'text/plain'} novalidate data-form="newsletter" data-custom-success data-subscribe-form>
          <div data-error-summary hidden></div>
          <div class="field">
            <label for="sub-email">Email<span class="req">*</span></label>
            <input id="sub-email" class="input" type="email" name="email" inputmode="email" autocomplete="email" placeholder="name@organisation.org" required data-label="email address" />
          </div>
          <div class="field">
            <label for="sub-first">First name</label>
            <input id="sub-first" class="input" type="text" name="firstName" autocomplete="given-name" />
          </div>
          <fieldset class="field">
            <legend>Lists</legend>
            <label class="check"><input type="checkbox" name="lists" value="policy-insights" checked /> Policy Insights (weekly)</label>
            <label class="check"><input type="checkbox" name="lists" value="news" /> RITA News (monthly)</label>
            <label class="check"><input type="checkbox" name="lists" value="events" /> Events &amp; launches</label>
          </fieldset>
          <div class="hp" aria-hidden="true"><label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
          <div class="field">
            <label class="check"><input id="sub-consent" type="checkbox" name="consent" required data-label="consent" data-message="Tick the box to continue" /> <span>I agree to receive emails from RITA. <a href="/privacy">Privacy policy</a>.<span class="req">*</span></span></label>
          </div>
          <div><button class="btn" type="submit">Subscribe</button></div>
        </form>
      </div>

      <div class="panel center" data-state="inbox" hidden tabindex="-1" role="status">
        <h1 class="h1">Check your inbox</h1>
        <p class="lead mt-16">We’ve sent a confirmation link to <strong data-sent-email></strong>. Didn’t get it? <button type="button" class="btn-link" data-resend disabled>Resend (in <span data-countdown>60</span>s)</button></p>
        <p class="mt-8 small mute" data-resent hidden>Sent again. Check your spam folder too.</p>
        <a class="btn btn-secondary mt-32" href="/">Back to site</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { sendForm } from '../../lib/api/forms';

  const form = document.querySelector<HTMLFormElement>('[data-subscribe-form]')!;
  const formPanel = document.querySelector<HTMLElement>('[data-state="form"]')!;
  const inbox = document.querySelector<HTMLElement>('[data-state="inbox"]')!;
  const resend = inbox.querySelector<HTMLButtonElement>('[data-resend]')!;
  const resent = inbox.querySelector<HTMLElement>('[data-resent]')!;
  let last: FormData | null = null;
  let timer: number | undefined;

  function startCountdown() {
    let n = 60;
    resend.disabled = true;
    resend.innerHTML = 'Resend (in <span data-countdown>60</span>s)';
    window.clearInterval(timer);
    timer = window.setInterval(() => {
      n -= 1;
      const c = resend.querySelector('[data-countdown]');
      if (c) c.textContent = String(n);
      if (n <= 0) { window.clearInterval(timer); resend.disabled = false; resend.textContent = 'Resend'; }
    }, 1000);
  }

  form.addEventListener('rita:form-success', (e) => {
    last = (e as CustomEvent<{ data: FormData }>).detail.data;
    inbox.querySelector('[data-sent-email]')!.textContent = String(last.get('email') ?? '');
    formPanel.hidden = true;
    inbox.hidden = false;
    inbox.focus();
    startCountdown();
  });
  resend.addEventListener('click', async () => {
    if (!last) return;
    resend.disabled = true;
    try { await sendForm('newsletter', last); resent.hidden = false; } catch { resent.hidden = false; resent.textContent = 'Something went wrong. Try again shortly.'; }
    startCountdown();
  });
</script>

<style>
  .panel { max-width: 560px; margin: 0 auto; background: var(--white); padding: 48px; }
  .panel:focus { outline: none; }
  @media (max-width: 599px) { .panel { padding: 28px 20px; } }
</style>
