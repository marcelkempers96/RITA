---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import ListRow from '../../../components/ListRow.astro';
import CtaBand from '../../../components/insights/CtaBand.astro';
import { load, url, authorLine, monthYear } from '../../../lib/content';

const d = await load();
const external = d.opeds.filter((o) => o.data.kind === 'policy-brief');
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title="Policy briefs" description="RITA policy briefs: recommendations for decision-makers, based on the team's research.">
  <span hidden data-pagefind-filter="type">Pages</span>
  <PageHead title="Policy briefs" crumbs={[['Policy', '/policy'], ['Briefs']]} lead="Recommendations for decision-makers, four pages each, based on our research." />

  <section class="section ruled">
    <div class="wrap">
      <h2 class="h2 mb-24">RITA Policy Brief series</h2>
      <div class="list">
        {d.briefs.map((b) => (
          <ListRow href={url.brief(b.id)} type={`Brief ${pad(b.data.number)}`} code={b.data.programme} title={b.data.title}
            meta={b.data.recommendations.length ? 'RITA' : 'RITA · Forthcoming'} year={b.data.date?.slice(0, 4)} />
        ))}
      </div>
    </div>
  </section>

  <section class="section ruled">
    <div class="wrap">
      <h2 class="h2">Briefs by our team elsewhere</h2>
      <p class="mute mt-8 mb-24">Policy briefs written by RITA’s team for other organisations, including work before RITA was established.</p>
      <div class="list">
        {external.map((o) => o.data.outletUrl ? (
          <ListRow href={o.data.outletUrl} external type="Policy brief" code={o.data.programme} title={o.data.title}
            meta={`${o.data.outlet} · ${authorLine(o.data.authors)}`} year={monthYear(o.data.date)} />
        ) : (
          <div class="lrow nolink">
            <span class="label"><span class:list={['sq', o.data.programme ? `c-${o.data.programme}` : 'c-none']} aria-hidden="true"></span>Policy brief</span>
            <span class="lrow-title">{o.data.title}</span>
            <span class="lrow-meta">{o.data.outlet} · {authorLine(o.data.authors)}</span>
            <span class="lrow-year">{monthYear(o.data.date)}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Work with us." text="Commission research or request a briefing." href="/contact?type=policy" cta="Get in touch →" />
</Base>
<style>.nolink .lrow-title { color: var(--mute-2); }</style>
