---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import Photo from '../../../components/Photo.astro';
import Tbc from '../../../components/Tbc.astro';
import ShareBar from '../../../components/ShareBar.astro';
import { load, url } from '../../../lib/content';
import { eventDate, eventTime, isPast, googleCalendarUrl, eventStart, eventEnd, FORMAT_LABEL } from '../../../components/insights/eventTime';
import { AFRICA, REST } from '../../../components/insights/countries';

export const getStaticPaths = (async () => {
  const d = await load();
  return d.events.map((e) => ({ params: { slug: e.id }, props: { event: e } }));
}) satisfies GetStaticPaths;

const { event } = Astro.props as { event: CollectionEntry<'events'> };
const d = await load();
const e = event.data;
const pageUrl = new URL(url.event(event.id), Astro.site).toString();
const speakers = e.speakers.map((id) => d.people.find((p) => p.id === id)).filter((p) => p !== undefined);
const past = isPast(e);
// The form closes once the event starts; the back-end closes it at capacity (set registrationOpen=false in the CMS).
const open = e.registrationOpen && !past;
// No-JS fallback: post to the forms back-end, or hand the entry to the user's mail app.
const endpoint = import.meta.env.PUBLIC_FORMS_ENDPOINT;
const action = endpoint ? `${endpoint}/event` : 'mailto:events@rita.africa';
const gcal = googleCalendarUrl(e, `${e.about}\n\n${pageUrl}`);
const where = e.format === 'online' ? 'Online, link emailed after registration' : e.format === 'hybrid' ? `${e.venue ?? 'Venue TBC'} and online` : e.venue;
const affiliation: Record<string, string> = { 'gideon-ndubuisi': 'TU Delft', 'elvis-korku-avenyo': 'University of Johannesburg' };
const start = eventStart(e), end = eventEnd(e);
---
<Base title={e.title} description={e.about} ogType="website"
  jsonLd={{ '@context': 'https://schema.org', '@type': 'Event', name: e.title, description: e.about, url: pageUrl,
    eventAttendanceMode: `https://schema.org/${e.format === 'online' ? 'Online' : e.format === 'hybrid' ? 'Mixed' : 'Offline'}EventAttendanceMode`,
    eventStatus: 'https://schema.org/EventScheduled',
    ...(start ? { startDate: start.toISOString(), endDate: end!.toISOString() } : {}),
    location: e.format === 'online' ? { '@type': 'VirtualLocation', url: pageUrl } : { '@type': 'Place', name: e.venue ?? 'TBC' },
    organizer: { '@type': 'ResearchOrganization', name: 'Research Institute for Transitions in Africa' },
    performer: speakers.map((s) => ({ '@type': 'Person', name: s.data.name })) }}>
  <span hidden data-pagefind-filter="type">Insight</span>
  <section class="wrap">
    <Crumbs items={[['Insights', '/insights'], ['Events', '/insights/events'], [e.title]]} />
    <div class="head">
      <div data-pagefind-meta="type:Event">
        <p class="row"><span class="tag tag-format">{FORMAT_LABEL[e.format]}</span> <span class="tag">{e.eventType}</span></p>
        <h1 class="h1 mt-16">{e.title}</h1>
        <div class="row mt-32">
          {open && <a class="btn" href="#register">Register</a>}
          {start ? (
            <>
              <a class="btn btn-secondary" href={`${url.event(event.id)}.ics`} download>Add to calendar (.ics)</a>
              {gcal && <a class="btn btn-secondary" href={gcal} target="_blank" rel="noopener">Google Calendar<span class="sr-only"> (opens in a new tab)</span></a>}
            </>
          ) : (
            <span class="mute small">Add to calendar once the date is set.</span>
          )}
        </div>
      </div>
      <Photo shot="Event or audience" eager />
    </div>
  </section>

  <section class="facts-band">
    <div class="wrap">
      <dl class="facts">
        <div class="fact"><dt>Date</dt><dd>{eventDate(e) ?? <Tbc label="Date TBC" />}</dd></div>
        <div class="fact"><dt>Time</dt><dd>{eventTime(e) ?? <Tbc label="Time TBC" />}<span class="mute small block">{e.durationMinutes} min</span></dd></div>
        <div class="fact"><dt>Where</dt><dd>{where ?? <Tbc label="Venue TBC" />}</dd></div>
        <div class="fact"><dt>Language</dt><dd>{e.language}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap with-aside">
      <div class="prose">
        <h2>About</h2>
        <p>{e.about}</p>
      </div>
      <aside class="stack" style="--stack:24px" aria-label="Speakers and sharing">
        <div class="box-paper">
          <h2 class="label">Speakers</h2>
          <ul class="nolist speakers">
            {speakers.map((s) => <li><a href={url.person(s.id)}>{s.data.name}</a>{affiliation[s.id] && ` — ${affiliation[s.id]}`}</li>)}
            {e.speakersTbc.map((s) => <li>{s} — <Tbc /></li>)}
          </ul>
        </div>
        <div class="box-paper"><ShareBar title={e.title} /></div>
      </aside>
    </div>
  </section>

  <section id="register" class="section bg-paper" aria-labelledby="register-title">
    <div class="wrap"><div class="narrow">
      <h2 id="register-title" class="h2">Register</h2>
      {!open ? (
        <p class="lead mt-16">{past ? 'This event has finished.' : 'Registration is closed.'} <a href="/subscribe" data-open="newsletter">Subscribe to Events &amp; launches</a> to hear about the next one.</p>
      ) : (
        <form class="form mt-24" action={action} method="post" enctype={endpoint ? undefined : "text/plain"} novalidate data-form="event"
          data-success-title="You’re registered."
          data-success-text="We’ve emailed your confirmation and a calendar invite. The joining link arrives 24 hours before.">
          <div data-error-summary hidden></div>
          <input type="hidden" name="event" value={event.id} />
          <div class="grid g2">
            <div class="field"><label for="ev-first">First name<span class="req">*</span></label><input id="ev-first" class="input" name="firstName" autocomplete="given-name" required data-label="first name" /></div>
            <div class="field"><label for="ev-last">Last name<span class="req">*</span></label><input id="ev-last" class="input" name="lastName" autocomplete="family-name" required data-label="last name" /></div>
            <div class="field"><label for="ev-email">Email<span class="req">*</span></label><input id="ev-email" class="input" type="email" name="email" inputmode="email" autocomplete="email" placeholder="name@organisation.org" required data-label="email address" /></div>
            <div class="field"><label for="ev-org">Organisation<span class="req">*</span></label><input id="ev-org" class="input" name="organisation" autocomplete="organization" required data-label="organisation" /></div>
            <div class="field"><label for="ev-role">Role</label><input id="ev-role" class="input" name="role" autocomplete="organization-title" /></div>
            <div class="field">
              <label for="ev-country">Country<span class="req">*</span></label>
              <select id="ev-country" class="select" name="country" autocomplete="country-name" required data-label="country">
                <option value="">Select a country</option>
                <optgroup label="Africa">{AFRICA.map((c) => <option>{c}</option>)}</optgroup>
                <optgroup label="Rest of the world">{REST.map((c) => <option>{c}</option>)}</optgroup>
              </select>
            </div>
          </div>
          {e.format === 'hybrid' && (
            <fieldset class="field">
              <legend>Attendance<span class="req">*</span></legend>
              <label class="check"><input type="radio" name="attendance" value="in-person" required data-label="attendance" data-message="Select how you will attend" /> In person</label>
              <label class="check"><input type="radio" name="attendance" value="online" /> Online</label>
            </fieldset>
          )}
          <div class="field">
            <label for="ev-access">Accessibility needs</label>
            <p class="hint" id="ev-access-hint">Tell us anything that would help you take part, for example captions or step-free access.</p>
            <textarea id="ev-access" class="textarea small-ta" name="accessibility" aria-describedby="ev-access-hint"></textarea>
          </div>
          <div class="hp" aria-hidden="true"><label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
          <div class="field">
            <label class="check"><input id="ev-consent" type="checkbox" name="consent" required data-label="consent" data-message="Tick the box to continue" /> <span>I agree to RITA using my details to manage my registration. <a href="/privacy">Privacy policy</a>.<span class="req">*</span></span></label>
          </div>
          <div><button class="btn" type="submit">Register</button></div>
        </form>
      )}
    </div></div>
  </section>
</Base>

<style>
  .head { display: grid; grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: center; padding: 40px 0 56px; }
  .tag-format { background: var(--malachite); color: var(--white); border-color: var(--malachite); }
  .facts-band { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 28px 0; }
  .block { display: block; }
  .box-paper { background: var(--paper); padding: 24px; }
  .speakers { display: grid; gap: 10px; margin-top: 12px; }
  .narrow { max-width: 960px; }
  .small-ta { min-height: 96px; }
  @media (max-width: 899px) { .head { grid-template-columns: 1fr; gap: 32px; } }
</style>
