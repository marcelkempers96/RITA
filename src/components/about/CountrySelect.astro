---
interface Props { id: string; name?: string; required?: boolean }
const { id, name = 'country', required = false } = Astro.props;
const AFRICA = ['Algeria', 'Angola', 'Benin', 'Botswana', 'Burkina Faso', 'Burundi', 'Cabo Verde', 'Cameroon', 'Central African Republic', 'Chad', 'Comoros',
  'Congo, Democratic Republic of the', 'Congo, Republic of the', "Côte d'Ivoire", 'Djibouti', 'Egypt', 'Equatorial Guinea', 'Eritrea', 'Eswatini', 'Ethiopia',
  'Gabon', 'Gambia', 'Ghana', 'Guinea', 'Guinea-Bissau', 'Kenya', 'Lesotho', 'Liberia', 'Libya', 'Madagascar', 'Malawi', 'Mali', 'Mauritania', 'Mauritius',
  'Morocco', 'Mozambique', 'Namibia', 'Niger', 'Nigeria', 'Rwanda', 'São Tomé and Príncipe', 'Senegal', 'Seychelles', 'Sierra Leone', 'Somalia', 'South Africa',
  'South Sudan', 'Sudan', 'Tanzania', 'Togo', 'Tunisia', 'Uganda', 'Zambia', 'Zimbabwe'];
---
<select id={id} name={name} class="select" required={required} autocomplete="country-name" data-label="country">
  <option value="">Choose a country</option>
  <optgroup label="Africa">
    {AFRICA.map((c) => <option value={c}>{c}</option>)}
  </optgroup>
  <option value="Outside Africa">Outside Africa</option>
</select>
