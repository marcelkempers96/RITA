---
// 23 Submit form. Front-end only: storage, sign-in and the editorial workflow are a separate back-end build.
// Without JavaScript all four steps show as one long form.
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Tbc from '../../components/Tbc.astro';
import { PROGRAMMES, CODES } from '../../lib/content';

const api = import.meta.env.PUBLIC_SUBMISSIONS_API as string | undefined;
const steps = ['Details', 'Content', 'Images', 'Review & submit'];
const formats = [
  ['policy-insight', 'Policy Insight'],
  ['blog-op-ed', 'Blog / op-ed'],
  ['policy-brief', 'Policy brief'],
  ['working-paper', 'Working paper'],
];
---
<Base title="New submission" noindex noNewsletter>
  <div data-pagefind-ignore>
    <div class="wrap">
      <Crumbs items={[['Contribute', '/submit'], ['New submission']]} />
      <h1 class="sr-only">New submission</h1>
      <ol class="stepper nolist" data-stepper aria-label="Progress">
        {steps.map((s, i) => (
          <li data-stepper-item={i + 1}>
            <a href={`#step-${i + 1}`} data-goto={i + 1}>
              <span class="label mute">Step {i + 1}</span>
              <span class="step-name">{s}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <div class="wrap"><div class="box-sand mb-24" data-signin-gate hidden role="note"><strong>You need an account to submit.</strong> Your draft is kept in this browser. <a href="/studio/?next=/submit/new">Sign in or create an account →</a></div></div>
    <form id="submission" class="wrap sform" method="post" enctype="multipart/form-data"
      action={api ? `${api.replace(/\/$/, '')}/api/submissions` : '#'} novalidate data-submission-form>
      <noscript>
        <div class="tbc-block mt-32"><strong>JavaScript is off</strong>All steps are shown on one page. Saving drafts and the preview need JavaScript.</div>
      </noscript>
      <div data-error-summary hidden></div>
      <p class="autosave mute small" data-autosave-status aria-live="polite"></p>

      <section class="step" id="step-1" data-step="1" aria-labelledby="step-1-title">
        <h2 id="step-1-title" class="h2">1 · Details</h2>
        <div class="form mt-32">
          <fieldset class="field">
            <legend>Format<span class="req">*</span></legend>
            <div class="chips">
              {formats.map(([v, l], i) => (
                <label class="chip chip-radio">
                  <input type="radio" class="sr-only" name="format" id={`format-${v}`} value={v} required checked={i === 0} data-label="a format" data-message="Select a format" />
                  {l}
                </label>
              ))}
            </div>
          </fieldset>
          <div class="two">
            <div class="field">
              <label for="programme">Programme<span class="req">*</span></label>
              <select id="programme" name="programme" class="select" required data-label="programme" data-message="Select a programme">
                <option value="">Choose a programme</option>
                {CODES.map((c) => <option value={c}>{PROGRAMMES[c].name}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="tags">Tags</label>
              <input id="tags" name="tags" class="input" type="text" placeholder="e.g. AfCFTA, skills" autocomplete="off" />
              <p class="hint">Separate tags with commas.</p>
            </div>
          </div>
          <div class="field">
            <label for="title">Title<span class="req">*</span> <span class="mute hint-inline">(max 90 characters)</span></label>
            <input id="title" name="title" class="input" type="text" required data-maxlength="90" data-label="title" autocomplete="off" aria-describedby="title-count" />
            <p class="counter mono" id="title-count" data-count-chars="title" data-max="90">0 / 90 characters</p>
          </div>
          <div class="field">
            <label for="standfirst">Standfirst<span class="req">*</span> <span class="mute hint-inline">(max 40 words; appears under the title and in previews)</span></label>
            <textarea id="standfirst" name="standfirst" class="textarea short" required data-max-words="40" data-label="standfirst" aria-describedby="standfirst-count"></textarea>
            <p class="counter mono" id="standfirst-count" data-count-words="standfirst" data-max="40">0 / 40 words</p>
          </div>
          <div class="two">
            <div class="field">
              <label for="author">Author</label>
              <input id="author" name="author" class="input" type="text" autocomplete="name" />
              <p class="hint">Filled in from your account once sign-in is connected. <Tbc /></p>
            </div>
            <div class="field">
              <label for="coauthor-input">Co-authors</label>
              <div class="combo">
                <input id="coauthor-input" name="coAuthorsText" class="input" type="text" placeholder="Add by name or email" autocomplete="off" />
                <button type="button" class="btn btn-secondary add" data-add-coauthor hidden>Add +</button>
              </div>
              <ul class="nolist coauthors" data-coauthors aria-live="polite"></ul>
            </div>
          </div>
        </div>
      </section>

      <section class="step" id="step-2" data-step="2" aria-labelledby="step-2-title">
        <h2 id="step-2-title" class="h2">2 · Content</h2>
        <p class="mute mt-8">Write here, or upload a file instead.</p>
        <div class="form mt-32">
          <div class="field" data-body-field>
            <label for="body">Body<span class="req">*</span> <span class="mute hint-inline" data-body-hint>(600–900 words for a Policy Insight)</span></label>
            <div class="editor">
              <div class="editor-bar">
                <span class="mute small">Plain text. Use ## for headings, - for lists and [text](link) for links.</span>
                <span class="mono wc" data-wordcount aria-live="polite">0 words</span>
              </div>
              <textarea id="body" name="body" class="textarea body-input" required data-label="body" data-message="Write your piece or upload a file" placeholder="Start writing…"></textarea>
            </div>
          </div>
          <div class="field">
            <label for="file" data-file-label>Or upload a file (.docx or PDF)</label>
            <input id="file" name="file" class="input file" type="file" accept=".docx,.pdf,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" data-label="file" data-message="Upload your working paper as a PDF" />
            <p class="hint" data-file-hint>If you upload a file, you can leave the body empty.</p>
          </div>
          <div class="field">
            <label for="references">References</label>
            <textarea id="references" name="references" class="textarea short" placeholder="One per line, with links"></textarea>
            <p class="hint">One per line, with links.</p>
          </div>
        </div>
      </section>

      <section class="step" id="step-3" data-step="3" aria-labelledby="step-3-title">
        <h2 id="step-3-title" class="h2">3 · Images</h2>
        <p class="mute mt-8">Optional. A header image is recommended.</p>
        <div class="form mt-32">
          <div class="field">
            <label for="image">Header image</label>
            <input id="image" name="image" class="input file" type="file" accept="image/jpeg,image/png" data-max-mb="10" data-label="header image" />
            <p class="hint">JPG/PNG, max 10MB.</p>
            <img class="thumb" data-image-preview alt="" hidden />
          </div>
          <div class="two">
            <div class="field">
              <label for="caption">Caption</label>
              <input id="caption" name="imageCaption" class="input" type="text" autocomplete="off" />
            </div>
            <div class="field">
              <label for="credit">Credit<span class="req" data-image-req>*</span></label>
              <input id="credit" name="imageCredit" class="input" type="text" placeholder="Photographer / source" autocomplete="off" data-image-dependent data-label="credit" />
            </div>
          </div>
          <div class="field">
            <label for="alt">Alt text<span class="req">*</span></label>
            <input id="alt" name="imageAlt" class="input" type="text" placeholder="Describe the image for screen readers" autocomplete="off" data-image-dependent data-label="alt text" />
            <p class="hint">Describe the image for screen readers.</p>
          </div>
          <div class="field">
            <label class="check"><input id="rights" type="checkbox" name="imageRights" value="yes" data-image-dependent data-message="Confirm you own this image or have permission to publish it" /> <span>I own this image or have permission to publish it<span class="req">*</span></span></label>
          </div>
          <p class="hint">Credit, alt text and the permission box are required when you add an image.</p>
        </div>
      </section>

      <section class="step" id="step-4" data-step="4" aria-labelledby="step-4-title">
        <h2 id="step-4-title" class="h2">4 · Review &amp; submit</h2>
        <dl class="review mt-32" data-review hidden></dl>
        <div class="form mt-32">
          <div class="field">
            <label class="check"><input id="decl-original" type="checkbox" name="declOriginal" value="yes" required /> <span>This is my original work and has not been published elsewhere (or I have the right to republish it).<span class="req">*</span></span></label>
          </div>
          <div class="field">
            <label class="check"><input id="decl-coi" type="checkbox" name="declCoi" value="yes" required /> <span>I have declared any conflicts of interest below.<span class="req">*</span></span></label>
          </div>
          <div class="field">
            <label for="coi">Conflicts of interest</label>
            <textarea id="coi" name="coiText" class="textarea short" placeholder="None"></textarea>
          </div>
          <div class="field">
            <label class="check"><input id="decl-editing" type="checkbox" name="declEditing" value="yes" required /> <span>I agree to RITA editing this piece for style and length.<span class="req">*</span></span></label>
          </div>
          <div class="actions">
            <button type="submit" class="btn">Submit for review</button>
            <button type="button" class="btn btn-secondary" data-preview data-open="preview" aria-haspopup="dialog" hidden>Preview</button>
            <button type="button" class="btn btn-secondary" data-save-draft hidden>Save draft</button>
            <p class="mute small">You can still edit until an editor picks it up.</p>
          </div>
          <p class="small" data-draft-msg role="status"></p>
        </div>
      </section>

      <div class="step-nav" data-step-nav hidden>
        <button type="button" class="btn btn-secondary" data-prev>← Back</button>
        <button type="button" class="btn" data-next>Next →</button>
      </div>
    </form>

    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="preview-title" hidden data-overlay="preview">
      <div class="modal-panel preview-panel">
        <button type="button" class="modal-close" data-close aria-label="Close preview">✕</button>
        <p class="label mute" data-pv-label>Preview</p>
        <h2 id="preview-title" class="h1 mt-16" data-pv-title>Untitled</h2>
        <p class="lead mt-16" data-pv-standfirst></p>
        <p class="label mute mt-16" data-pv-author></p>
        <div class="prose mt-32" data-pv-body></div>
      </div>
    </div>
  </div>
</Base>

<script>
  import '../../components/submit/submit-form';
  import { needsSignIn } from '../../lib/api/submissions';
  needsSignIn().then((gate) => { const el = document.querySelector<HTMLElement>('[data-signin-gate]'); if (el) el.hidden = !gate; });
</script>

<style>
  .stepper { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding: 48px 0 40px; border-bottom: 1px solid var(--line); }
  .stepper a { display: grid; gap: 8px; padding-top: 18px; border-top: 3px solid var(--line); text-decoration: none; color: var(--mute); }
  .stepper .step-name { font-size: 22px; font-weight: 600; }
  .stepper [data-done] a, .stepper [aria-current='step'] a { border-top-color: var(--ink); color: var(--ink); }
  .stepper [aria-current='step'] .step-name { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 2px; }
  .sform { padding-bottom: 72px; }
  .sform [data-error-summary] { margin-top: 32px; }
  .autosave { margin-top: 24px; min-height: 1.5em; }
  .step { padding: 48px 0; border-bottom: 1px solid var(--line); }
  .js-steps .step { border-bottom: 0; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .hint-inline { font-weight: 400; font-size: 15px; }
  .short { min-height: 88px; }
  .counter { font-size: 13px; color: var(--mute); }
  .counter.over { color: var(--laterite); font-weight: 500; }
  .chip-radio:has(input:checked) { background: var(--ink); color: var(--white); border-color: var(--ink); }
  .chip-radio:has(input:focus-visible) { outline: 3px solid var(--sun); outline-offset: 2px; }
  .chip-radio { border-color: var(--ink); }
  .combo { display: flex; gap: 8px; }
  .combo .input { flex: 1; min-width: 0; }
  .add { flex: none; }
  .coauthors { display: flex; flex-wrap: wrap; gap: 8px; }
  .coauthors:not(:empty) { margin-top: 4px; }
  .coauthors :global(button) { display: inline-flex; align-items: center; gap: 8px; padding: 9px 15px; border: 1px solid var(--ink); background: var(--white); font: 500 15px/1.2 var(--sans); cursor: pointer; }
  .coauthors :global(button:hover) { background: var(--laterite); color: var(--white); border-color: var(--laterite); }
  .editor { border: 1px solid #A8A59D; }
  .editor:focus-within { outline: 3px solid var(--sun); }
  .editor-bar { display: flex; justify-content: space-between; gap: 16px; padding: 10px 14px; background: var(--paper); border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .wc { font-size: 13px; letter-spacing: .06em; text-transform: uppercase; }
  .wc.warn { color: var(--laterite); }
  .wc.ok { color: var(--malachite); }
  .body-input { border: 0; min-height: 320px; }
  .body-input:focus-visible { outline: none; }
  .body-input[aria-invalid='true'] { border: 0 !important; }
  [data-body-field]:has([aria-invalid='true']) .editor { border: 2px solid var(--laterite); }
  .file { padding: 10px; }
  .thumb { max-width: 320px; aspect-ratio: 4 / 3; object-fit: cover; border-bottom: 4px solid var(--ink); }
  .review { display: grid; grid-template-columns: 180px 1fr; gap: 10px 24px; padding: 24px; background: var(--paper); }
  .review :global(dt) { font: 500 12px/1.6 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--mute); }
  .review :global(dd) { margin: 0; }
  .actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .step-nav { display: flex; justify-content: space-between; gap: 12px; padding-top: 8px; }
  .preview-panel { width: min(860px, 100%); }
  @media (max-width: 899px) {
    .stepper { grid-template-columns: repeat(4, 1fr); gap: 8px; padding: 24px 0; }
    .stepper .step-name { font-size: 14px; }
    .stepper .label { font-size: 11px; }
    .two { grid-template-columns: 1fr; }
    .review { grid-template-columns: 1fr; }
  }
</style>
