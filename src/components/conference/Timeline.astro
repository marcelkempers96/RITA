---
// Key dates as a vertical timeline. Past dates are greyed and the next date is highlighted;
// a small script recomputes this in the visitor's browser so it stays right between rebuilds.
import { KEY_DATES } from '../../data/conference';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const fmt = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const items = compact ? KEY_DATES.filter((d) => d.milestone || ['2026-12-01', '2027-05-15', '2027-07-31'].includes(d.date)) : KEY_DATES;
---
<ol class="tl nolist" data-timeline>
  {items.map((d) => (
    <li class:list={['tl-item', { milestone: d.milestone }]} data-date={d.date}>
      <time class="tl-date mono" datetime={d.date}>{fmt(d.date)}</time>
      <span class="tl-dot" aria-hidden="true"></span>
      <div class="tl-body">
        <p class="tl-label">{d.label}<span class="tl-next label" hidden>Next</span></p>
        {!compact && <p class="tl-detail">{d.detail}</p>}
      </div>
    </li>
  ))}
</ol>

<script>
  const today = new Date().toISOString().slice(0, 10);
  document.querySelectorAll<HTMLElement>('[data-timeline]').forEach((tl) => {
    let marked = false;
    tl.querySelectorAll<HTMLElement>('[data-date]').forEach((li) => {
      const past = li.dataset.date! < today;
      li.classList.toggle('past', past);
      if (!past && !marked) { li.classList.add('next'); li.querySelector<HTMLElement>('.tl-next')!.hidden = false; marked = true; }
    });
  });
</script>

<style>
  .tl { position: relative; }
  .tl-item { display: grid; grid-template-columns: 150px 20px minmax(0, 1fr); gap: 0 20px; position: relative; padding-bottom: 28px; }
  .tl-item::before { content: ''; position: absolute; left: 179px; top: 14px; bottom: -6px; width: 1px; background: var(--line); }
  .tl-item:last-child::before { display: none; }
  .tl-date { font-size: 14px; font-weight: 500; color: var(--mute-2); padding-top: 3px; text-align: right; }
  .tl-dot { width: 12px; height: 12px; margin: 6px 4px 0; background: var(--white); border: 2px solid var(--ink); position: relative; z-index: 1; }
  .milestone .tl-dot { background: var(--ink); width: 16px; height: 16px; margin: 4px 2px 0; }
  .tl-label { font-weight: 600; font-size: 18px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .milestone .tl-label { font-size: 21px; }
  .tl-detail { color: var(--mute); font-size: 15px; margin-top: 4px; max-width: 520px; }
  .tl-next { background: var(--sun); color: var(--ink); padding: 3px 8px; font-size: 11px; }
  .past .tl-label, .past .tl-date { color: var(--mute); }
  .past .tl-dot { border-color: var(--line); background: var(--line); }
  .next .tl-dot { background: var(--sun); border-color: var(--ink); }
  :global(.bg-ink) .tl-date, :global(.bg-ink) .tl-detail { color: var(--on-dark-mute); }
  :global(.bg-ink) .tl-dot { background: var(--ink); border-color: var(--white); }
  :global(.bg-ink) .milestone .tl-dot { background: var(--white); }
  :global(.bg-ink) .tl-item::before { background: #3a3936; }
  @media (max-width: 599px) {
    .tl-item { grid-template-columns: 20px minmax(0, 1fr); gap: 2px 14px; }
    .tl-date { grid-column: 2; grid-row: 1; text-align: left; }
    .tl-dot { grid-column: 1; grid-row: 1 / span 2; }
    .tl-body { grid-column: 2; }
    .tl-item::before { left: 9px; }
  }
</style>
