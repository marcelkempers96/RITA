---
import LegalPage from '../components/legal/LegalPage.astro';
import { INBOX } from '../lib/site';
const sections = [
  { id: 'what-we-use', title: 'In short', html: `<p>One essential cookie to remember your choice. Nothing for advertising. Analytics only if you say yes, and even then without cookies.</p>` },
  { id: 'essential', title: 'Essential', html: `<table class="ctable"><thead><tr><th>Name</th><th>What it does</th><th>How long</th></tr></thead><tbody>
    <tr><td><code>rita_consent</code></td><td>Remembers your cookie choice.</td><td>12 months</td></tr>
    <tr><td><code>rita-consent</code> (browser storage)</td><td>The same choice, read by the page.</td><td>12 months</td></tr>
    <tr><td><code>rita-autosave:*</code> (browser storage)</td><td>Keeps your draft on <a href="/submit/new">Publish with RITA</a> if you close the page. Stays on your device.</td><td>Until you submit or clear it</td></tr>
    </tbody></table>` },
  { id: 'analytics', title: 'Analytics', html: `<p>We use <a href="https://plausible.io/data-policy" rel="noopener">Plausible</a> to count visits. It sets no cookies and collects no personal data. We still only load it after you accept analytics.</p>` },
  { id: 'your-choice', title: 'Your choice', html: `<p>We keep your choice for 12 months, then ask again. Change it any time below, or with “Cookie settings” in the footer.</p>` },
  { id: 'contact', title: 'Contact', html: `<p><a href="mailto:${INBOX.privacy}">${INBOX.privacy}</a></p>` },
];
---
<LegalPage title="Cookie policy" description="The cookies RITA uses, what they do and how to change your choice." sections={sections}>
  <section id="settings" class="settings box-sand" aria-labelledby="settings-h">
    <h2 id="settings-h" class="h3">Cookie settings</h2>
    <p class="mt-8">Essential cookies are always on. Analytics stay off until you agree.</p>
    <a href="/cookies#settings" class="btn mt-16" data-open="cookies">Change cookie settings</a>
  </section>
</LegalPage>

<style>
  .settings { margin-top: 48px; scroll-margin-top: calc(var(--header-h) + 24px); }
  :global(.ctable) { width: 100%; border-collapse: collapse; font-size: 15px; }
  :global(.ctable th) { text-align: left; font: 500 12px/1.3 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--mute); padding: 10px 12px 10px 0; border-bottom: 1px solid var(--ink); }
  :global(.ctable td) { padding: 12px 12px 12px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
</style>
