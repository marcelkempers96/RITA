---
// Ink band above the footer (WEBSITE-CONTENT "Newsletter band"). Double opt-in via the email provider.
// Without JS and without a back-end, the form falls back to GET /subscribe?email=… (the full form, prefilled).
const endpoint = import.meta.env.PUBLIC_FORMS_ENDPOINT;
const action = endpoint ? `${endpoint}/newsletter` : '/subscribe';
const method = endpoint ? 'post' : 'get';
---
<section class="band bg-ink" aria-labelledby="nl-band-title" data-pagefind-ignore>
  <div class="wrap inner">
    <div>
      <h2 id="nl-band-title" class="h2">Policy Insights, every week.</h2>
      <p class="sub">Short reads on Africa’s green industrialisation. Unsubscribe any time.</p>
    </div>
    <form class="nl" action={action} method={method} novalidate data-form="newsletter" data-success-title="Check your inbox" data-success-text="We’ve sent a confirmation link. Click it to start your subscription.">
      <div data-error-summary hidden></div>
      <div class="field">
        <label for="nl-band-email" class="sr-only">Email address</label>
        <div class="combo">
          <input id="nl-band-email" class="input" type="email" name="email" autocomplete="email" inputmode="email" placeholder="Email address" required data-label="email address" />
          <button class="btn" type="submit">Subscribe</button>
        </div>
      </div>
      <input type="hidden" name="lists" value="policy-insights" />
      <div class="hp" aria-hidden="true"><label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
      <div class="field">
        <label class="check"><input type="checkbox" name="consent" required data-label="consent" data-message="Tick the box to continue" /> <span>I agree to receive emails from RITA. <a href="/privacy">Privacy policy</a>.</span></label>
      </div>
    </form>
  </div>
</section>

<style>
  .band { padding: 56px 0; }
  .inner { display: grid; grid-template-columns: 1fr 500px; gap: 40px; align-items: center; }
  .sub { color: var(--on-dark-mute); margin-top: 10px; font-size: 18px; }
  .nl { display: grid; gap: 12px; }
  .combo { display: flex; }
  .combo .input { border-color: var(--white); flex: 1; min-width: 0; }
  .combo .btn { flex: none; }
  .check { font-size: 14px; color: var(--on-dark-mute); }
  .check a { color: inherit; }
  @media (max-width: 899px) { .inner { grid-template-columns: 1fr; } }
</style>
