---
import LegalPage from '../components/legal/LegalPage.astro';
import { INBOX } from '../lib/site';
const sections = [
  { id: 'commitment', title: 'Our commitment', html: `<p>We want everyone to be able to use this website, whatever device or assistive technology they use.</p>` },
  { id: 'standard', title: 'Standard', html: `<p>We aim to meet WCAG 2.2 AA. We test with keyboard only, screen readers (NVDA, VoiceOver), 400% zoom and contrast checks.</p>` },
  { id: 'known-issues', title: 'Known issues', html: `<p><span class="tbc">List TBC</span></p>` },
  { id: 'feedback', title: 'Feedback', html: `<p>Tell us about a problem: <a href="mailto:${INBOX.access}">${INBOX.access}</a>. We reply within 5 working days.</p>` },
];
---
<LegalPage title="Accessibility statement" kicker="Accessibility" description="RITA aims to meet WCAG 2.2 AA: how we test, known issues and how to tell us about a problem." sections={sections} numbered={false} draftNotice={false}>
  <p class="mt-48"><a class="link-arrow" href="/sitemap">Sitemap →</a></p>
</LegalPage>
