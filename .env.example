# Canonical site origin, used for sitemap, RSS, canonical URLs and Open Graph.
SITE_URL=https://rita.africa

# Subpath hosting, e.g. /RITA for https://marcelkempers96.github.io/RITA/. Leave empty at a domain root.
BASE_PATH=

# Form back-end. When unset, forms run in demo mode: they validate and show the
# success state without sending anything. Point these at your serverless functions.
PUBLIC_FORMS_ENDPOINT=
PUBLIC_SUBMISSIONS_API=

# Privacy-friendly analytics, loaded only after cookie consent.
PUBLIC_PLAUSIBLE_DOMAIN=
