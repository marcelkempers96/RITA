---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Photo from '../../components/Photo.astro';
import PersonCard from '../../components/PersonCard.astro';
import InterestForm from '../../components/about/InterestForm.astro';
import { load } from '../../lib/content';

const d = await load();
const fellows = d.people.filter((p) => p.data.group === 'fellow');
const steps = [
  ['Register interest', 'Tell us who you are and what you work on. Takes five minutes.'],
  ['Apply', 'When the call opens, send a two-page proposal and your CV.'],
  ['Interview', 'A short conversation with the programme leads.'],
  ['Start', 'Join your cohort, agree your outputs, get to work.'],
];
const faq = [
  ['Who can apply?', 'African researchers with a PhD in economics or a related field, awarded in the last ten years. Final-year PhD candidates can apply too.'],
  ['Can I apply from outside Africa?', 'Yes. Diaspora researchers are welcome. Your work must be about Africa.'],
  ['Is the fellowship remote?', 'Yes. RITA is a network, not a building. You stay at your own institution. We work together online and meet in person when we can.'],
  ['Do I have to leave my job?', 'No. The fellowship runs alongside your current position.'],
  ['What languages can I work in?', 'English and French. We publish in English and can help with editing.'],
  ['What do fellows produce?', 'At least one research paper, two Policy Insights and a policy brief over two years. Most fellows co-author with a programme lead.'],
  ['Who owns my work?', 'You do. RITA publishes openly wherever rights allow, with you as author.'],
  ['How are fellows chosen?', 'On the quality and policy relevance of the proposal, fit with our four programmes, and track record for career stage. We aim for a cohort balanced across regions and genders.'],
  ['Is there an application fee?', 'No.'],
];
---
<Base title="RITA Fellowship" description="Two years with RITA for early- and mid-career African researchers working on industrial transformation.">
  <span hidden data-pagefind-filter="type">Page</span>
  <section class="hero">
    <div class="hero-text">
      <div class="hero-inner">
        <Crumbs items={[['Fellows', '/fellows'], ['Fellowship']]} />
        <h1 class="display mt-24">RITA Fellowship</h1>
        <p class="lead mt-24">Two years with RITA for early- and mid-career African researchers working on industrial transformation.</p>
        <div class="row mt-32">
          <a class="btn" href="#register">Register interest</a>
          <a class="btn btn-secondary" href="#faq">Read the FAQ</a>
        </div>
      </div>
    </div>
    <Photo shot="Researchers at work" ratio="auto" class="hero-photo" top eager />
  </section>

  <section class="section ruled">
    <div class="wrap">
      <h2 class="sr-only">Who, what and when</h2>
      <ul class="grid g3 nolist">
        <li class="wbox">
          <p class="label"><span class="sq c-IND" aria-hidden="true"></span>Who</p>
          <h3 class="h3 mt-16">African researchers within 10 years of their PhD</h3>
          <p class="mt-16 mute">Working on industrialisation, minerals, energy, firms or work. Based in Africa or the diaspora.</p>
        </li>
        <li class="wbox">
          <p class="label"><span class="sq c-IND" aria-hidden="true"></span>What</p>
          <h3 class="h3 mt-16">Stipend, mentoring by programme leads, publication support</h3>
          <p class="mt-16 mute">Two years. A research stipend, a programme lead as mentor, editing and a platform for your work.</p>
        </li>
        <li class="wbox">
          <p class="label"><span class="sq c-IND" aria-hidden="true"></span>When</p>
          <h3 class="h3 mt-16">First call: announced soon</h3>
          <p class="mt-16 mute">Register interest now. You will hear first when the call opens.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section ruled">
    <div class="wrap">
      <h2 class="h2 mb-32">How it works</h2>
      <ol class="grid g4 nolist steps">
        {steps.map((s, i) => (
          <li><span class="mono mute">0{i + 1}</span><span class="h3 step-title">{s[0]}</span><span class="mute small">{s[1]}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section ruled">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">Current fellows</h2>
        <a class="link-arrow" href="/fellows?group=fellows">All fellows →</a>
      </div>
      {fellows.length ? (
        <ul class="grid g4 nolist">{fellows.map((p) => <li><PersonCard person={p} /></li>)}</ul>
      ) : (
        <>
          <p class="mute mb-32">The first cohort will be listed here.</p>
          <ul class="grid g4 nolist" aria-hidden="true">{Array.from({ length: 4 }).map(() => <li><PersonCard placeholder="Fellow" /></li>)}</ul>
        </>
      )}
    </div>
  </section>

  <section class="section ruled" id="faq" aria-labelledby="faq-title">
    <div class="wrap">
      <h2 id="faq-title" class="h2 mb-32">FAQ</h2>
      <div class="acc">
        {faq.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <div class="acc-body"><p>{a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-paper" id="register" aria-labelledby="register-title">
    <div class="wrap">
      <div class="form-wrap">
        <h2 id="register-title" class="h2">Register interest</h2>
        <p class="mute mt-8 mb-32">Tell us about yourself and we’ll contact you when the call opens.</p>
        <InterestForm name="fellowship" prefix="fs" />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1fr 1fr; min-height: 520px; }
  .hero-text { display: flex; align-items: center; justify-content: flex-end; padding: 40px 64px 72px; }
  .hero-inner { max-width: 512px; width: 100%; }
  .hero-inner :global(.crumbs) { padding-top: 0; }
  .hero :global(.hero-photo) { min-height: 320px; height: 100%; }
  .wbox { background: var(--paper); padding: 28px; }
  .steps li { border-top: 4px solid var(--malachite); padding-top: 24px; display: flex; flex-direction: column; gap: 10px; }
  .step-title { display: block; }
  .form-wrap { max-width: 880px; }
  @media (max-width: 899px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .hero-text { padding: 24px var(--pad) 40px; justify-content: flex-start; }
    .hero :global(.hero-photo) { min-height: 220px; }
  }
</style>
