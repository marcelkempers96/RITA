---
// Key dates as a ruled list, in the same style as the site's list rows: date on the left, milestone on the right.
// Past dates are muted and the next one is marked; a small script recomputes this in the visitor's browser.
import { KEY_DATES } from '../../data/conference';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const d = (iso: string) => new Date(`${iso}T12:00:00Z`);
const day = (iso: string) => d(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const year = (iso: string) => d(iso).getUTCFullYear();
const items = compact ? KEY_DATES.filter((k) => k.milestone || ['2026-12-01', '2027-05-15', '2027-07-31'].includes(k.date)) : KEY_DATES;
---
<ol class:list={['kd', 'nolist', { compact }]} data-timeline>
  {items.map((k) => (
    <li class:list={['kd-row', { milestone: k.milestone }]} data-date={k.date}>
      <time class="kd-date" datetime={k.date}><span class="kd-day">{day(k.date)}</span><span class="kd-year mono">{year(k.date)}</span></time>
      <div class="kd-body">
        <p class="kd-label">{k.label}</p>
        {!compact && <p class="kd-detail">{k.detail}</p>}
      </div>
      <span class="kd-next label" hidden>Next</span>
    </li>
  ))}
</ol>

<script>
  const today = new Date().toISOString().slice(0, 10);
  document.querySelectorAll<HTMLElement>('[data-timeline]').forEach((tl) => {
    let marked = false;
    tl.querySelectorAll<HTMLElement>('[data-date]').forEach((li) => {
      const past = li.dataset.date! < today;
      li.classList.toggle('past', past);
      if (!past && !marked) { li.classList.add('next'); li.querySelector<HTMLElement>('.kd-next')!.hidden = false; marked = true; }
    });
  });
</script>

<style>
  .kd { border-bottom: 1px solid var(--line); }
  .kd-row { display: grid; grid-template-columns: 140px minmax(0, 1fr) auto; gap: 24px; align-items: baseline; padding: 20px 0; border-top: 1px solid var(--line); }
  .kd-date { display: flex; flex-direction: column; gap: 2px; }
  .kd-day { font-size: 24px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; }
  .kd-year { font-size: 13px; color: var(--mute); }
  .kd-label { font-size: 18px; font-weight: 500; line-height: 1.35; }
  .kd-detail { color: var(--mute); font-size: 15px; margin-top: 4px; max-width: 560px; }
  .kd-next { color: var(--mute-2); font-size: 12px; }
  .milestone { background: var(--sand); padding-left: 20px; padding-right: 20px; margin: 0 -20px; }
  .milestone .kd-label { font-weight: 600; font-size: 20px; }
  .milestone .kd-detail { color: var(--mute-2); }
  .next { border-top: 3px solid var(--sun); }
  .past .kd-day, .past .kd-label { color: var(--mute); }
  .compact .kd-row { padding: 14px 0; grid-template-columns: 110px minmax(0, 1fr) auto; }
  .compact .kd-day { font-size: 20px; }
  .compact .milestone { padding-left: 16px; padding-right: 16px; margin: 0 -16px; }
  :global(.bg-ink) .kd, :global(.bg-ink) .kd-row { border-color: #3a3936; }
  :global(.bg-ink) .kd-year, :global(.bg-ink) .kd-next { color: var(--on-dark-mute); }
  :global(.bg-ink) .milestone { background: #1f1e1c; }
  :global(.bg-ink) .past .kd-day, :global(.bg-ink) .past .kd-label { color: #8a877f; }
  @media (max-width: 599px) {
    .kd-row { grid-template-columns: 92px minmax(0, 1fr); gap: 16px; }
    .kd-day { font-size: 19px; }
    .kd-next { grid-column: 2; }
    .milestone { padding-left: 12px; padding-right: 12px; margin: 0 -12px; }
  }
</style>
